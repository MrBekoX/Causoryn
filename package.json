    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "secret-scan": "node scripts/secret-scan.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "yaml": "^2.9.1"
  }
}
