{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mrbekox/causoryn",
  "title": "Causoryn",
  "description": "Local, deterministic, LLM-free codebase and change intelligence MCP server.",
  "version": "0.3.2",
  "websiteUrl": "https://github.com/MrBekoX/Causoryn",
  "repository": {
    "url": "https://github.com/MrBekoX/Causoryn",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "causoryn",
      "version": "0.3.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "--ignore-scripts"
        },
        {
          "type": "positional",
          "value": "--prefix=~/"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "--allow-cwd"
        },
        {
          "type": "positional",
          "value": "--auto-data-dir"
        }
      ]
    }
  ]
}
